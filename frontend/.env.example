# Backend API base URL.
# - Local dev: leave empty (Vite proxies /api and /uploads to localhost:5000).
# - Single Render Web Service (frontend + API same origin): leave empty.
# - Frontend on Vercel + API on Render: set this to the Render API URL, e.g.
#     VITE_API_URL=https://newecommerece.onrender.com/api
#   (This must be set as a Vercel Project Environment Variable and the
#    Vercel domain added to the backend's CLIENT_ORIGIN.)
VITE_API_URL=

# Only used by the dev server proxy
VITE_API_PROXY_TARGET=http://localhost:5000
